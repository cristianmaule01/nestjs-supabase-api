# --- compiled output ---
# The /dist folder should generally be IGNORED in Git because it's generated by `npm run build`.
# Railway handles the build process, so we keep /dist ignored.
/dist
/build 

# /node_modules should always be ignored.
/node_modules

# --- Logs ---
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
lerna-debug.log*

# --- OS ---
.DS_Store

# --- Tests ---
/coverage
/.nyc_output

# --- IDEs and editors ---
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# --- IDE - VSCode ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- dotenv environment variable files ---
# CRUCIAL: These MUST be ignored so you don't commit secrets.
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# --- temp directory ---
.temp
.tmp

# --- Runtime data ---
pids
*.pid
*.seed
*.pid.lock

# --- Diagnostic reports ---
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
